apiVersion: v1
kind: ConfigMap
metadata:
  name: distribution-proxy-config
  namespace: mirror-distribution
  labels:
    app: distribution-proxy
data:
  config.yml: |
    version: 0.1
    log:
      level: info
      fields:
        service: registry
    storage:
      filesystem:
        rootdirectory: /var/lib/registry
      delete:
        enabled: false
      cache:
        blobdescriptor: inmemory
    http:
      addr: :5000
      headers:
        X-Content-Type-Options: [nosniff]
    health:
      storagedriver:
        enabled: true
        interval: 10s
        threshold: 3
${PROXY_BLOCK}
