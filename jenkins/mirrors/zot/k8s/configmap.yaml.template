apiVersion: v1
kind: ConfigMap
metadata:
  name: zot-config
  namespace: mirror-zot
data:
  config.json: |
    {
      "distSpecVersion": "1.1.0",
      "storage": {
        "rootDirectory": "/var/lib/registry"
      },
      "http": {
        "compat": ["docker2s2"],
        "address": "0.0.0.0",
        "port": "5000"
      },
      "log": {
        "level": "info"
      },
      "extensions": {
        "sync": {
          "enable": true,
          ${SYNC_CREDENTIALS_FILE_BLOCK}"registries": [
            {
              "urls": ["${SYNC_URL}"],
              "onDemand": true,
              "tlsVerify": ${SYNC_TLS_VERIFY},
              "content": [
                {
                  "prefix": "${CHAINGUARD_ORG}/**",
                  "stripPrefix": true
                }
              ]
            }
          ]
        }
      }
    }
