apiVersion: v1
kind: ConfigMap
metadata:
  name: zot-config
  namespace: mirror-zot
data:
  config.json: |
    {
      "distSpecVersion": "1.1.0",
      "storage": {
        "rootDirectory": "/var/lib/registry"
      },
      "http": {
        "compat": ["docker2s2"],
        "address": "0.0.0.0",
        "port": "5000"
      },
      "log": {
        "level": "info"
      },
      "extensions": {
        "sync": {
          "enable": true,
          "registries": [
            {
              "urls": ["http://cgr-oidc-proxy.cgr-oidc-proxy.svc.cluster.local:5000"],
              "onDemand": true,
              "tlsVerify": false,
              "content": [
                {
                  "prefix": "${CHAINGUARD_ORG}/**",
                  "stripPrefix": true
                }
              ]
            }
          ]
        }
      }
    }
