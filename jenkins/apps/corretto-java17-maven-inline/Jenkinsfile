// Inlined twin of apps/corretto-java17-maven/Jenkinsfile — no shared-
// library calls. Hardcoded for: harbor mirror, proxy auth,
// CHAINGUARD_ORG=smalls.xyz. See README.md.

pipeline {
  agent none
  options { timestamps() }

  stages {

    stage('Auth') {
      agent any
      steps {
        sh '''
          set -eu
          mkdir -p "$DOCKER_CONFIG"
          AUTH=$(printf 'admin:Harbor12345' | base64 | tr -d '\\n')
          cat > "$DOCKER_CONFIG/config.json" <<EOF
{ "auths": { "localhost": { "auth": "$AUTH" }, "localhost:80": { "auth": "$AUTH" } } }
EOF
        '''
      }
    }

    stage('Checkout') {
      agent any
      steps {
        sh 'cp -R /sources/apps/corretto-java17-maven-inline/. .'
        stash name: 'src', includes: '**', excludes: 'target/**'
      }
    }

    stage('Build') {
      agent {
        docker {
          image 'localhost/cgr-proxy/smalls.xyz/maven:3-jdk17-dev@sha256:2ef87b6d8b49cce6a4954346b20972ffee4f1259a4507e8f6f1b1abef180d5c0'
          args '--entrypoint='
          reuseNode true
        }
      }
      steps {
        unstash 'src'
        sh 'mvn -B -ntp clean package -DskipTests'
        stash name: 'app-jar', includes: 'target/app.jar'
      }
    }

    stage('Test') {
      agent {
        docker {
          image 'localhost/cgr-proxy/smalls.xyz/amazon-corretto-jre:17-dev@sha256:a34fe97ec1f505f8db6e64651c322b4c1f135816fc993d4e2a561380be0ad1a7'
          args '--entrypoint='
          reuseNode true
        }
      }
      steps {
        unstash 'app-jar'
        sh 'java -jar target/app.jar'
      }
    }

    stage('Archive') {
      agent any
      steps {
        unstash 'app-jar'
        archiveArtifacts artifacts: 'target/app.jar', fingerprint: true
      }
    }
  }
}
