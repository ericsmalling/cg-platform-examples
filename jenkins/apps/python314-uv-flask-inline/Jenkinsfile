// Inlined twin of apps/python314-uv-flask/Jenkinsfile — no shared-library
// calls. Hardcoded for: harbor mirror, proxy auth, push to library,
// CHAINGUARD_ORG=smalls.xyz. See README.md.

pipeline {
  agent none
  options { timestamps() }

  environment {
    IMAGE = 'localhost/library/pytest-inline:3-14'
  }

  stages {

    stage('Auth') {
      agent any
      steps {
        sh '''
          set -eu
          mkdir -p "$DOCKER_CONFIG"
          AUTH=$(printf 'admin:Harbor12345' | base64 | tr -d '\\n')
          cat > "$DOCKER_CONFIG/config.json" <<EOF
{ "auths": { "localhost": { "auth": "$AUTH" }, "localhost:80": { "auth": "$AUTH" } } }
EOF
        '''
      }
    }

    stage('Checkout') {
      agent any
      steps {
        sh 'cp -R /sources/apps/python314-uv-flask-inline/. .'
        stash name: 'src', includes: '**'
      }
    }

    stage('Build deps') {
      agent {
        docker {
          image 'localhost/cgr-proxy/smalls.xyz/python:3.14-dev@sha256:d83b1ceb93ad3c461b19ce91aa1ec5de9390d072f9b1966176d1f1678851f860'
          args '--user 0 --entrypoint='
          reuseNode true
        }
      }
      steps {
        unstash 'src'
        sh 'uv pip install --system --no-cache flask'
        sh 'python -c "import flask; print(\\"flask\\", flask.__version__)"'
      }
    }

    stage('Image build') {
      agent any
      steps {
        unstash 'src'
        sh 'docker build --build-arg PULL_REGISTRY=localhost/cgr-proxy/smalls.xyz -t "$IMAGE" .'
      }
    }

    stage('Test') {
      agent any
      steps {
        sh '''
          set -e
          docker run --rm --entrypoint=python -e PYTHONPATH=/app "$IMAGE" -c "
from app import app
c = app.test_client()
r = c.get('/')
assert r.status_code == 200, 'unexpected status: ' + str(r.status_code)
assert b'Hello from Flask on Chainguard' in r.data, 'greeting missing'
print('Smoke test passed')
"
        '''
      }
    }

    stage('Push') {
      agent any
      steps {
        sh 'docker push "$IMAGE"'
      }
    }

    stage('Sign') {
      agent any
      steps {
        withCredentials([
          file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY_FILE'),
          string(credentialsId: 'cosign-password',  variable: 'COSIGN_PASSWORD'),
        ]) {
          sh '''
            set -eu
            # Most-recent RepoDigest for this repo (re-pushes append; tail picks the latest).
            DIGEST=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$IMAGE" | grep -F "${IMAGE%:*}@" | tail -1)
            # cosign's parser rejects bare 'localhost' as a registry hostname.
            DIGEST="localhost:80/${DIGEST#localhost/}"
            docker run --rm --network host \\
              -v "$COSIGN_KEY_FILE:/cosign.key:ro" \\
              -v "$DOCKER_CONFIG:/jenkins-docker:ro" \\
              -e "COSIGN_PASSWORD=$COSIGN_PASSWORD" \\
              -e DOCKER_CONFIG=/jenkins-docker \\
              --entrypoint=/usr/bin/cosign \\
              localhost/cgr-proxy/smalls.xyz/cosign:latest-dev \\
              sign --yes --allow-http-registry --key /cosign.key "$DIGEST"
          '''
        }
      }
    }

    stage('Verify') {
      agent any
      steps {
        withCredentials([
          file(credentialsId: 'cosign-public-key', variable: 'COSIGN_PUB_FILE'),
        ]) {
          sh '''
            set -eu
            DIGEST=$(docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$IMAGE" | grep -F "${IMAGE%:*}@" | tail -1)
            DIGEST="localhost:80/${DIGEST#localhost/}"
            docker run --rm --network host \\
              -v "$COSIGN_PUB_FILE:/cosign.pub:ro" \\
              -v "$DOCKER_CONFIG:/jenkins-docker:ro" \\
              -e DOCKER_CONFIG=/jenkins-docker \\
              --entrypoint=/usr/bin/cosign \\
              localhost/cgr-proxy/smalls.xyz/cosign:latest-dev \\
              verify --allow-http-registry --key /cosign.pub "$DIGEST" >/dev/null
          '''
        }
      }
    }
  }
}
